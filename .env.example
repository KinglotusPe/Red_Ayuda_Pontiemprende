# ============================================================
# RED AYUDA — CONFIGURACIÓN DE ENTORNO (EJEMPLO)
# Copiar como .env para desarrollo local o configurar en CI/CD
# ============================================================

# SERVIDOR BACKEND
SERVER_PORT=8080
APP_ENV=development
APP_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# BASE DE DATOS POSTGRESQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=red_ayuda_db
DB_USER=redayuda_user
DB_PASSWORD=redayuda_secret_password

# SEGURIDAD Y JWT
JWT_SECRET=super_secret_jwt_key_red_ayuda_minimum_32_characters_for_hmac_sha256
JWT_EXPIRATION_MS=900000          # 15 minutos
JWT_REFRESH_EXPIRATION_MS=604800000 # 7 días

# SHARE TOKENS PÚBLICOS DE EMERGENCIA
SHARE_TOKEN_EXPIRATION_HOURS=24

# S3 / MINIO ALMACENAMIENTO PRIVADO DE AUDIOS
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio_access_key
S3_SECRET_KEY=minio_secret_key
S3_BUCKET_NAME=red-ayuda-audios
S3_REGION=us-east-1

# NOTIFICACIONES FIREBASE CLOUD MESSAGING (DEV MOCK SI NO HAY CREDENCIAL)
FIREBASE_CONFIG_PATH=
FIREBASE_ENABLED=false

# PROVEEDORES SMS Y WHATSAPP (DEV MOCK SI NO HAY CREDENCIAL)
SMS_PROVIDER=DEV_MOCK
SMS_TWILIO_ACCOUNT_SID=
SMS_TWILIO_AUTH_TOKEN=
SMS_TWILIO_PHONE_NUMBER=

WHATSAPP_PROVIDER=DEV_MOCK
WHATSAPP_META_ACCESS_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=

# WEBSOCKET STOMP
WS_ALLOWED_ORIGINS=*

# ADMIN CREDENTIALS POR DEFECTO EN SEED DEV
DEV_ADMIN_EMAIL=admin@redayuda.pe
DEV_ADMIN_PASSWORD=Admin123456!
